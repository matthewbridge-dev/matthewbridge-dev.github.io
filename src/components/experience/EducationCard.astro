---
export interface Props {
  institution: string;
  degree: string;
  location: string;
  startDate: string;
  endDate?: string;
  gpa?: string;
  description?: string;
  coursework?: string[];
  accolades?: string[];
  extracurricular?: string[];
}

const {
  institution,
  degree,
  location,
  startDate,
  endDate = "Present",
  gpa,
  description,
  coursework = [],
  accolades = [],
  extracurricular = [],
} = Astro.props;
---

<article
  class="bg-surface border border-white/5 rounded-2xl p-6 md:p-8 shadow-md transition-all duration-300 hover:border-accent/40 hover:bg-surface-elevated/60"
>
  <div
    class="flex flex-col md:flex-row md:justify-between md:items-start gap-2 mb-4"
  >
    <div>
      <h3
        class="text-xl md:text-2xl font-bold text-text-primary tracking-tight"
      >
        {degree}
      </h3>
      <h4 class="text-base md:text-lg font-semibold text-accent mt-1">
        {institution}
      </h4>

      {
        gpa && (
          <div class="mt-2">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-accent-tie-subtle border border-accent-tie/20 text-accent-tie text-xs font-semibold rounded-full">
              <svg
                class="w-3.5 h-3.5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                />
              </svg>
              <span>{gpa}</span>
            </span>
          </div>
        )
      }
    </div>

    <div class="mt-1 md:mt-0 flex flex-col md:items-end gap-1">
      <span
        class="inline-block px-3 py-1 bg-accent-subtle border border-accent/20 rounded-full text-xs font-medium text-accent"
      >
        {startDate} — {endDate}
      </span>
      <p class="text-xs md:text-sm text-text-muted flex items-center gap-1">
        <svg
          class="w-3.5 h-3.5 text-text-muted/70"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
          ></path>
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
        </svg>
        {location}
      </p>
    </div>
  </div>

  {
    description && (
      <p class="text-text-muted text-sm md:text-base leading-relaxed mb-6">
        {description}
      </p>
    )
  }

  {
    (coursework.length > 0 ||
      accolades.length > 0 ||
      extracurricular.length > 0) && (
      <div class="flex flex-col md:flex-row gap-6 pt-5 border-t border-white/5">
        {coursework.length > 0 && (
          <div class="flex-1">
            <span class="text-xs font-bold text-text-muted uppercase tracking-wider block mb-2.5">
              Relevant Coursework
            </span>
            <div class="flex flex-wrap gap-2">
              {coursework.map((course) => (
                <span class="px-2.5 py-1 text-xs font-medium text-accent bg-accent-subtle border border-accent/20 rounded-md">
                  {course}
                </span>
              ))}
            </div>
          </div>
        )}

        {accolades.length > 0 && (
          <div class="flex-1">
            <span class="text-xs font-bold text-text-muted uppercase tracking-wider block mb-2.5">
              Honors & Accolades
            </span>
            <div class="flex flex-wrap gap-2">
              {accolades.map((item) => (
                <span class="px-2.5 py-1 text-xs font-medium text-text-primary bg-white/5 border border-white/10 rounded-md">
                  {item}
                </span>
              ))}
            </div>
          </div>
        )}

        {extracurricular.length > 0 && (
          <div class="flex-1">
            <span class="text-xs font-bold text-text-muted uppercase tracking-wider block mb-2.5">
              Extracurricular Activities
            </span>
            <div class="flex flex-wrap gap-2">
              {extracurricular.map((item) => (
                <span class="px-2.5 py-1 text-xs font-medium text-text-primary bg-white/5 border border-white/10 rounded-md">
                  {item}
                </span>
              ))}
            </div>
          </div>
        )}
      </div>
    )
  }
</article>
