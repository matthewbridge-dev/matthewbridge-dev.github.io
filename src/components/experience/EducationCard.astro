---
export interface Props {
  institution: string;
  degree: string;
  location: string;
  startDate: string;
  endDate?: string;
  description?: string;
  accolades?: string[];
  extracurricular?: string[];
}

const {
  institution,
  degree,
  location,
  startDate,
  endDate = "Present", // Defaults to "Present" if left blank
  description,
  accolades = [],
  extracurricular = [],
} = Astro.props;
---

<article
  class="bg-bg-primary border border-white/10 rounded-2xl p-6 md:p-8 shadow-lg transition-all hover:border-accent/30"
>
  <div class="flex flex-col md:flex-row md:justify-between md:items-start mb-4">
    <div>
      <h3 class="text-xl md:text-2xl font-bold text-text-primary">
        {degree}
      </h3>
      <h4 class="text-lg font-medium text-accent mt-1">
        {institution}
      </h4>
    </div>

    <div class="mt-2 md:mt-0 text-left md:text-right">
      <span
        class="inline-block px-3 py-1 bg-white/5 border border-white/10 rounded-full text-xs font-medium text-slate-300 mb-2"
      >
        {startDate} — {endDate}
      </span>
      <p class="text-sm text-slate-400">
        {location}
      </p>
    </div>
  </div>

  {
    description && (
      <p class="text-slate-300 text-sm md:text-base leading-relaxed mb-6">
        {description}
      </p>
    )
  }

  <div class="flex flex-col gap-4">
    {
      accolades.length > 0 && (
        <div>
          <h5 class="text-sm font-bold text-text-primary mb-2 uppercase tracking-wider">
            Accolades
          </h5>
          <ul class="list-disc list-inside text-sm text-slate-400 space-y-1">
            {accolades.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      )
    }

    {
      extracurricular.length > 0 && (
        <div>
          <h5 class="text-sm font-bold text-text-primary mb-2 uppercase tracking-wider">
            Extracurriculars
          </h5>
          <ul class="list-disc list-inside text-sm text-slate-400 space-y-1">
            {extracurricular.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</article>
