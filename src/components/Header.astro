---
const pathname = Astro.url.pathname;

const navItems = [
  { label: "About", href: "/" },
  { label: "Projects", href: "/projects" },
  { label: "Experience", href: "/experience" },
];
---

<header
  class="w-full border-b border-white/5 bg-surface/85 backdrop-blur-md sticky top-0 z-50 transition-colors h-[var(--theme-header-h)] flex items-center"
>
  <div class="theme-container flex items-center justify-between">
    <a
      href="/"
      class="text-text-primary font-bold text-lg tracking-tight hover:text-accent transition-colors flex items-center gap-2 group"
    >
      <span
        class="w-2.5 h-2.5 rounded-full bg-accent group-hover:scale-125 transition-transform shrink-0"
      ></span>
      <span
        >MatthewBridge<span class="text-text-muted font-normal">.com</span
        ></span
      >
    </a>

    <nav class="flex items-center gap-1 sm:gap-2 text-sm font-medium">
      {
        navItems.map((item) => {
          const isActive =
            item.href === "/"
              ? pathname === "/" ||
                pathname === "/about" ||
                pathname === "/about/"
              : pathname === item.href || pathname.startsWith(item.href);
          return (
            <a
              href={item.href}
              class={`px-3.5 py-1.5 rounded-lg transition-all duration-200 ${
                isActive
                  ? "text-accent bg-accent-subtle font-semibold shadow-sm"
                  : "text-text-muted hover:text-text-primary hover:bg-white/5"
              }`}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>
  </div>
</header>
