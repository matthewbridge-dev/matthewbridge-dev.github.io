---
import "../styles/global.css";
---

<header
  class="w-full border-b border-bg-secondary/100 bg-bg-secondary/100 sticky top-0 z-50"
>
  <div class="max-w-5xl mx-auto px-6 h-12 flex items-center justify-between">
    <a
      href="/about"
      class="text-text-primary font-bold text-lg hover:text-accent transition-colors"
    >
      MatthewBridge<span class="text-text-muted">.com</span>
    </a>

    <nav class="flex items-center gap-6 text-sm font-medium text-text-muted">
      <a href="/about" class="hover:text-text-primary transition-colors"
        >About</a
      >
      <a href="/projects" class="hover:text-text-primary transition-colors"
        >Projects</a
      >
      <a href="/experience" class="hover:text-text-primary transition-colors"
        >Experience</a
      >
    </nav>
  </div>
</header>
