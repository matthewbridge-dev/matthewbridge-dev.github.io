---
export interface Props {
  title: string;
  description: string;
  tags: string[];
  imagePath: string;
  githubUrl?: string;
  demoUrl?: string;
}

const { title, description, tags, imagePath, githubUrl, demoUrl } = Astro.props;
---

<article
  class="group relative flex flex-col bg-bg-primary border border-white/10 rounded-2xl overflow-hidden shadow-lg transition-all duration-300 hover:border-accent/30"
>
  <div class="w-full h-48 overflow-hidden bg-slate-800">
    <img
      src={imagePath}
      alt={`Screenshot of ${title}`}
      class="w-full h-full object-cover transition-transform duration-500"
    />
  </div>

  <div class="p-6 flex flex-col flex-1">
    <h3 class="text-xl font-bold text-text-primary mb-2 transition-colors">
      {title}
    </h3>

    <p class="text-slate-400 text-sm mb-6 leading-relaxed flex-1">
      {description}
    </p>

    <div class="flex flex-wrap gap-2 mb-6">
      {
        tags.map((tag) => (
          <span class="px-3 py-1 text-xs font-medium text-accent bg-accent/10 border border-accent/20 rounded-full hover:-translate-y-0.5 transition-transform">
            {tag}
          </span>
        ))
      }
    </div>

    <div class="flex items-center gap-4 mt-auto border-t border-white/5 pt-4">
      {
        githubUrl && (
          <a
            href={githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm font-medium text-slate-300 hover:text-accent flex items-center gap-1.5 transition-colors"
          >
            <svg
              class="w-5 h-5"
              fill="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                fill-rule="evenodd"
                d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                clip-rule="evenodd"
              />
            </svg>
            Code
          </a>
        )
      }

      {
        demoUrl && (
          <a
            href={demoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm font-medium text-slate-300 hover:text-accent flex items-center gap-1.5 transition-colors"
          >
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
              />
            </svg>
            Live Demo
          </a>
        )
      }
    </div>
  </div>
</article>
