---
import ProjectCardFeatured from "./ProjectCardFeatured.astro";
import { getCollection } from "astro:content";

const allProjects = await getCollection("projects");
const featuredProjects = allProjects
  .filter((project) => project.data.featured === true)
  .slice(0, 3);
---

<section
  class="w-full bg-accent py-8 mt-0 mb-0 shadow-[0_0_30px_rgba(200,108,16,0.3)]"
>
  <div class="max-w-5xl mx-auto px-6">
    <h2
      class="text-3xl md:text-4xl font-bold text-bg-primary text-center mb-8 drop-shadow-sm"
    >
      Featured Projects
    </h2>
  </div>

  <div class="w-full px-4 lg:px-8">
    <div
      class={`grid grid-cols-1 gap-8 ${featuredProjects.length === 2 ? "md:grid-cols-2 lg:gap-16" : "md:grid-cols-3"}`}
    >
      {
        featuredProjects.map((project) => (
          <ProjectCardFeatured
            imagePath={project.data.imagePath || "/missing-project.jpg"}
            title={project.data.title}
            description={project.data.description}
            tags={project.data.technologies || []}
            githubUrl={project.data.repo}
            demoUrl={project.data.demo}
          />
        ))
      }
    </div>

    <div class="mt-8 w-full flex justify-center">
      <a
        href="/projects"
        class="inline-block px-8 py-3 text-base font-bold bg-bg-primary text-text-muted rounded-xl shadow-xl transition-all duration-300 hover:text-text-primary hover:shadow-2xl border border-white/5"
      >
        View All Projects
      </a>
    </div>
  </div>
</section>
