---
import * as aboutFile from "../../content/about/about.md";
const { name, title, about } = aboutFile.frontmatter;
---

<div
  class="flex flex-col md:flex-row items-center md:items-end justify-between gap-8 md:gap-16"
>
  <div class="w-full md:flex-1 self-center text-center md:text-left">
    <h1 class="text-3xl md:text-5xl font-bold text-text-primary mb-4">
      Welcome!
    </h1>
    <h2 class="text-2xl md:text-4xl font-bold text-text-primary mb-2">
      I'm {name}
    </h2>
    <p class="text-base md:text-lg font-normal text-accent mb-2">
      {title}
    </p>
    <p class="text-base md:text-lg font-normal text-text-muted mb-0">
      {about}
    </p>
    // RESUME AND CONTACT ME BUTTONS HERE
  </div>

  <div class="w-full md:w-auto shrink-0 flex justify-center md:justify-end">
    <img
      src="/profile-pic.png"
      alt={name}
      class="block w-auto h-56 md:h-128 box-content pt-6 px-6 pb-0 drop-shadow-[0_0_15px_rgba(200,108,16,0.6)]"
    />
  </div>
</div>
