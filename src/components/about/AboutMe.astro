---
import * as aboutFile from "../../content/about/about.md";
const { name, title, about } = aboutFile.frontmatter;
---

<div
  class="flex flex-col md:flex-row items-center md:items-end justify-between gap-4 md:gap-16"
>
  <div class="w-full md:flex-1 self-center text-center md:text-left">
    <h1 class="text-3xl md:text-5xl font-bold text-text-primary mb-4">
      Welcome!
    </h1>
    <h2 class="text-2xl md:text-4xl font-bold text-text-primary mb-2">
      I'm {name}
    </h2>
    <p class="text-base md:text-lg font-normal text-accent mb-2">
      {title}
    </p>
    <p class="text-base md:text-lg font-normal text-text-muted mb-0">
      {about}
    </p>
    <div
      class="mt-8 flex flex-col sm:flex-row items-center justify-center md:justify-start gap-4"
    >
      <div class="flex flex-col sm:flex-row w-full gap-4 mt-0">
        <a
          href="/resume.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="flex-1 justify-center group flex items-center gap-3 px-6 py-4 bg-bg-primary border border-white/10 rounded-2xl shadow-lg transition-all duration-300 hover:border-accent/50 hover:-translate-y-1 hover:shadow-2xl"
        >
          Download Resume
        </a>

        <a
          href="#contact"
          class="flex-1 justify-center group flex items-center gap-3 px-6 py-4 bg-bg-primary border border-white/10 rounded-2xl shadow-lg transition-all duration-300 hover:border-accent/50 hover:-translate-y-1 hover:shadow-2xl"
        >
          Let's Connect!
        </a>
      </div>
    </div>
  </div>

  <div class="w-full md:w-auto shrink-0 flex justify-center md:justify-end">
    <img
      src="/profile-pic.png"
      alt={name}
      class="block w-auto h-56 md:h-128 box-content pt-0 px-0 pb-0 drop-shadow-[0_0_15px_rgba(200,108,16,0.6)]"
    />
  </div>
</div>
