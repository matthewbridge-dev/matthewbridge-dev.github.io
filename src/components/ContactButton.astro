---
interface Props {
  action: 'link' | 'copy';
  value: string;
  hoverText: string;
  bgClass?: string;
}

const { action, value, hoverText, bgClass = "bg-bg-primary" } = Astro.props;

const Element = action === 'link' ? 'a' : 'button';

const dynamicAttributes = action === 'link' 
  ? { href: value, target: "_blank", rel: "noopener noreferrer" } 
  : { 'data-copy': value };
---

<Element 
  {...dynamicAttributes} 
  class={`copy-btn group flex items-center h-10 rounded-full ${bgClass} text-text-muted hover:text-accent border border-transparent hover:border-accent/30 transition-all duration-300 overflow-hidden cursor-pointer`}
>
  
  <div class="w-10 h-10 shrink-0 flex items-center justify-center">
    <slot /> 
  </div>

  <span class="copy-text max-w-0 overflow-hidden whitespace-nowrap transition-all duration-300 ease-in-out opacity-0 group-hover:max-w-xs group-hover:opacity-100 px-0 group-hover:pr-4 text-sm font-medium">
    {hoverText}
  </span>

</Element>

<script>
// ...
</script>