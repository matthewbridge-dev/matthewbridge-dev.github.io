---
export interface Props {
  title: string;
  description: string;
  date?: string;
  role?: string;
  tags: string[];
  imagePath?: string;
  githubUrl?: string;
  demoUrl?: string;
  isPrivate?: boolean;
  privateNote?: string;
}

const {
  title,
  description,
  date,
  role,
  tags,
  imagePath,
  githubUrl,
  demoUrl,
  isPrivate = false,
  privateNote,
} = Astro.props;

// Fallback image if imagePath fails or is missing
const displayImage =
  imagePath && imagePath.trim().length > 0
    ? imagePath
    : "/placeholder-project.svg";
---

<article
  class="group relative flex flex-col bg-surface border border-white/5 rounded-2xl overflow-hidden shadow-lg transition-all duration-300 hover:border-accent/40 hover:-translate-y-1.5 hover:shadow-2xl hover:shadow-accent/5"
>
  <div class="w-full aspect-video overflow-hidden bg-surface-elevated relative">
    <img
      src={displayImage}
      alt={`Screenshot of ${title}`}
      loading="lazy"
      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
      onerror="this.onerror=null; this.src='/placeholder-project.svg';"
    />
    <div
      class="absolute inset-0 bg-gradient-to-t from-surface via-transparent to-transparent opacity-40 group-hover:opacity-20 transition-opacity"
    >
    </div>
  </div>

  <div class="p-6 flex flex-col flex-1">
    <h3
      class="text-xl font-bold text-text-primary mb-1 group-hover:text-accent transition-colors"
    >
      {title}
    </h3>

    {
      (date || role) && (
        <div class="flex flex-col gap-1.5 mb-3.5">
          {date && (
            <div class="flex items-center gap-1.5 text-xs font-semibold text-accent/85 tracking-wide">
              <svg
                class="w-3.5 h-3.5 text-accent/70 shrink-0"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                />
              </svg>
              <span>{date}</span>
            </div>
          )}
          {role && (
            <div class="flex items-center gap-1.5 text-xs font-medium text-text-primary tracking-wide">
              {role.toLowerCase().includes("team") ||
              role.toLowerCase().includes("engineer") ? (
                <svg
                  class="w-3.5 h-3.5 text-accent shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
                  />
                </svg>
              ) : (
                <svg
                  class="w-3.5 h-3.5 text-accent shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                  />
                </svg>
              )}
              <span>{role}</span>
            </div>
          )}
        </div>
      )
    }

    <p class="text-text-muted text-sm mb-6 leading-relaxed flex-1">
      {description}
    </p>

    <div class="flex flex-wrap gap-2 mb-6">
      {
        tags.map((tag) => (
          <span class="px-2.5 py-1 text-xs font-medium text-accent bg-accent-subtle border border-accent/20 rounded-md">
            {tag}
          </span>
        ))
      }
    </div>

    <div class="flex items-center gap-4 mt-auto border-t border-white/5 pt-4">
      {
        isPrivate ? (
          <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-accent-tie px-2.5 py-1 rounded-md bg-accent-tie-subtle border border-accent-tie/20">
            <svg
              class="w-3.5 h-3.5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
              />
            </svg>
            <span>{privateNote || "Private Repo (Production)"}</span>
          </span>
        ) : (
          githubUrl &&
          githubUrl.trim().length > 0 && (
            <a
              href={githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm font-medium text-text-muted hover:text-accent flex items-center gap-1.5 transition-colors"
            >
              <svg
                class="w-4 h-4"
                fill="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  fill-rule="evenodd"
                  d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                  clip-rule="evenodd"
                />
              </svg>
              Source Code
            </a>
          )
        )
      }

      {
        demoUrl && (
          <a
            href={demoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm font-medium text-text-muted hover:text-accent flex items-center gap-1.5 transition-colors"
          >
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
              />
            </svg>
            Live Demo
          </a>
        )
      }
    </div>
  </div>
</article>
