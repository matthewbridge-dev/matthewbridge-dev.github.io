---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  </head>

  <body
    class="min-h-screen flex flex-col justify-between text-text-primary bg-bg-primary overflow-x-hidden"
  >
    <Header />

    <main class="grow w-full px-0 py-0">
      <slot />
    </main>

    <Footer />
  </body>
</html>
