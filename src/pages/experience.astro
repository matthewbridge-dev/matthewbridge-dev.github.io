---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout>
<div class="max-w-5xl mx-auto px-6 py-12">
  
  <section class="mb-12">
    <h2 class="text-2xl font-bold text-text-primary mb-4">Experience</h2>
    <div class="bg-bg-secondary p-6 rounded-xl border border-border-subtle">
      <h3>IT Support Specialist</h3>
      <p>Fixed all the computers.</p>
    </div>
  </section>

  <section>
    <h2 class="text-2xl font-bold text-text-primary mb-4">Education</h2>
    <div class="bg-bg-secondary p-6 rounded-xl border border-border-subtle">
      <h3>Computer Science</h3>
      <p>University Name</p>
    </div>
  </section>

</div>
</BaseLayout>