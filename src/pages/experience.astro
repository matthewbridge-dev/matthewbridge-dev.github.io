---
import BaseLayout from "../layouts/BaseLayout.astro";
import ExperienceCard from "../components/experience/ExperienceCard.astro";
import EducationCard from "../components/experience/EducationCard.astro";
import { getCollection, type CollectionEntry } from "astro:content";

const rawExperience = await getCollection("experience");
const rawEducation = await getCollection("education");

function parseDateScore(dateStr?: string): number {
  if (!dateStr || dateStr.toLowerCase().includes("present")) {
    return Number.MAX_SAFE_INTEGER;
  }
  const cleaned = dateStr
    .replace(/^(est\.?|expected|anticipated)\s+/i, "")
    .replace(/\./g, "")
    .trim();
  const parsed = new Date(cleaned).getTime();
  return isNaN(parsed) ? 0 : parsed;
}

const sortedExperience = rawExperience.sort(
  (a: CollectionEntry<"experience">, b: CollectionEntry<"experience">) => {
    const endA = parseDateScore(a.data.endDate);
    const endB = parseDateScore(b.data.endDate);
    if (endB !== endA) return endB - endA;
    return parseDateScore(b.data.startDate) - parseDateScore(a.data.startDate);
  },
);

const sortedEducation = rawEducation.sort(
  (a: CollectionEntry<"education">, b: CollectionEntry<"education">) => {
    const endA = parseDateScore(a.data.endDate);
    const endB = parseDateScore(b.data.endDate);
    if (endB !== endA) return endB - endA;
    return parseDateScore(b.data.startDate) - parseDateScore(a.data.startDate);
  },
);
---

<BaseLayout
  title="Education & Experience"
  description="Academic background in Computer Science, engineering roles, and technical timeline for Matthew Bridge."
>
  <div class="theme-container py-12">
    <div class="mb-12">
      <h1
        class="text-3xl md:text-5xl font-bold text-text-primary tracking-tight mb-4"
      >
        Education & Experience
      </h1>
      <p class="text-base md:text-lg text-text-muted max-w-2xl">
        A chronicle of my academic background in Computer Science, followed by
        my hands-on engineering roles and technical mentorship work.
      </p>
    </div>

    <!-- Education Section (First) -->
    <section class="mb-16">
      <div class="flex items-center gap-3 mb-6">
        <h2
          class="text-2xl md:text-3xl font-bold text-text-primary tracking-tight"
        >
          Education
        </h2>
        <span
          class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-surface border border-white/10 text-text-muted"
        >
          {sortedEducation.length} degrees
        </span>
      </div>

      <div class="grid grid-cols-1 theme-card-grid">
        {
          sortedEducation.map((edu) => (
            <EducationCard
              institution={edu.data.institution}
              degree={edu.data.degree}
              location={edu.data.location}
              startDate={edu.data.startDate}
              endDate={edu.data.endDate}
              gpa={edu.data.gpa}
              description={edu.data.description}
              coursework={edu.data.coursework || []}
              accolades={edu.data.accolades || []}
              extracurricular={edu.data.extracurricular || []}
            />
          ))
        }
      </div>
    </section>

    <!-- Experience Section (Second) -->
    <section>
      <div class="flex items-center gap-3 mb-6">
        <h2
          class="text-2xl md:text-3xl font-bold text-text-primary tracking-tight"
        >
          Work Experience
        </h2>
        <span
          class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-surface border border-white/10 text-text-muted"
        >
          {sortedExperience.length} positions
        </span>
      </div>

      <div class="grid grid-cols-1 theme-card-grid">
        {
          sortedExperience.map((exp) => (
            <ExperienceCard
              company={exp.data.company}
              title={exp.data.title}
              location={exp.data.location}
              startDate={exp.data.startDate}
              endDate={exp.data.endDate}
              isCurrent={exp.data.isCurrent}
              description={exp.data.description}
              skills={exp.data.skills || []}
              highlights={exp.data.highlights || []}
            />
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>
